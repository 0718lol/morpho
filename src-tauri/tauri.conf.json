{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morpho",
  "version": "0.1.0",
  "identifier": "io.github.a0718lol.morpho",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Morpho — 万物皆可转",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../engines/ffmpeg/*",
      "../engines/poppler/*",
      "../engines/pandoc/*",
      "../engines/qpdf/*",
      "../engines/tesseract/*",
      "../engines/libreoffice/*"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}